 			/*
 			 * If resource's size is larger than its alignment,
@@ -1349,9 +1391,68 @@
 	win_align = window_alignment(bus, b_res->flags);
 	min_align = calculate_head_align(aligns, max_order);
 	min_align = max(min_align, win_align);
+	if (nvbigbar_enabled && big_cnt >= 1) {
+		/*
+		 * v6：只把 min_align 抬到巨型窗的对齐，不再给「对齐跳空」补尺寸。
+		 *
+		 * v5 的 gap = big_align * (big_cnt - 1) 会逐层重复累加：子桥窗本身
+		 * 也是 r_size > align 的资源，于是每上一层都再补一份 32G。实测顶部
+		 * root port 被吹到 160G+，而 above-4G 孔径只有 256G 且被 iGPU 的
+		 * VF BAR2(0x4020000000-0x40ffffffff) 和 ixgbe pref 窗
+		 * (0x6842400000~) 切成 ~157G + ~150G 两段，32G 对齐下放不下，
+		 * 六次重试后整条链回滚，三张卡 BAR1 全变成 0（连 3090 的 32G 也丢），
+		 * nvidia 驱动直接 -1。真实需求只有 96G+96M，按原样申请即可。
+		 */
+		min_align = max(min_align, big_align);
+		pr_info("PCI: nvbigbar: %04x:%02x %pR 巨型窗 %d 个 align %lluMB 不补洞\n",
+			pci_domain_nr(bus), bus->number, b_res, big_cnt,
+			(unsigned long long)(big_align >> 20));
