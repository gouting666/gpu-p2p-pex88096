+	    !(b_res->flags & IORESOURCE_PREFETCH) &&
+	    pci_is_root_bus(bus->parent) && nvbigbar_bus_has_nv_gpu(bus)) {
+		resource_size_t want = SZ_512M + SZ_256M + SZ_128M;
+
+		if (size0 < want) {
+			pr_info("PCI: nvbigbar: root port %04x:%02x 非 pref 窗 %lluMB -> %lluMB\n",
+				pci_domain_nr(bus), bus->number,
+				(unsigned long long)(size0 >> 20),
+				(unsigned long long)(want >> 20));
+			size0 = want;
+		}
+	}
+
