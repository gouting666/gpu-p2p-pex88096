 				  0, win_align);
 
+	/* 实验补丁 v9：窗口自身对齐到最大子对齐，尺寸也取该对齐的整数倍 */
+	if (nv_pack && nv_max_align) {
+		v9_old = size0;
+		if (nv_max_align > min_align)
+			min_align = nv_max_align;
+		size0 = round_up(size0, nv_max_align);
+		if (size0 != v9_old)
+			pr_info("PCI: nvbigbar: %04x:%02x 非 pref 窗 %lluMB -> %lluMB（%lluMB 对齐）\n",
+				pci_domain_nr(bus), bus->number,
+				(unsigned long long)(v9_old >> 20),
+				(unsigned long long)(size0 >> 20),
+				(unsigned long long)(nv_max_align >> 20));
