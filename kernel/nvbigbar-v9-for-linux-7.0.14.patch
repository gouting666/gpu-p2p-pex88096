@@ -1295,6 +1324,10 @@
 
 	max_order = 0;
 	size = 0;
+	/* 实验补丁 v9：NV 子树的非 pref 窗，子资源按对齐上取整累加 */
+	nv_pack = nvbigbar_enabled && bus->self &&
+		  !(b_res->flags & IORESOURCE_PREFETCH) &&
+		  nvbigbar_bus_has_nv_gpu(bus);
 
 	list_for_each_entry(dev, &bus->devices, bus_list) {
