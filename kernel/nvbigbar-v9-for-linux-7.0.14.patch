 	resource_size_t children_add_size = 0;
 	resource_size_t add_align = 0;
+	resource_size_t big_align = 0;	/* 实验补丁 v5 */
+	int big_cnt = 0;		/* 实验补丁 v5 */
+	bool nv_pack = false;		/* 实验补丁 v9 */
+	resource_size_t nv_max_align = 0;	/* 实验补丁 v9 */
+	resource_size_t v9_old;		/* 实验补丁 v9 */
 
 	if (!b_res)
